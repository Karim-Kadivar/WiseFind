# WiseFind Application Environment Variables

# Application Host URL & Port
APP_URL="http://localhost:3000"

# MongoDB Connection URI (Local or MongoDB Atlas connection string)
# Example for local: mongodb://127.0.0.1:27017/wisefind
# Example for Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/wisefind?retryWrites=true&w=majority
MONGODB_URI="mongodb://127.0.0.1:27017/wisefind"
MONGODB_DB_NAME="wisefind"

# Optional Gemini AI API Key
GEMINI_API_KEY=""

# -------------------------------------------------------------
# GOOGLE OAUTH 2.0 AUTHENTICATION (Backend Localhost Flow)
# -------------------------------------------------------------
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Click "Create Credentials" -> "OAuth client ID" -> "Web application"
# 3. Add to "Authorized JavaScript origins":
#    http://localhost:3000
# 4. Add to "Authorized redirect URIs":
#    http://localhost:3000/api/auth/google/callback
# 5. Copy the generated Client ID & Client Secret below:
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"

# -------------------------------------------------------------
# GMAIL SMTP NOTIFICATION SERVICE (hello.wisefind@gmail.com)
# -------------------------------------------------------------
GMAIL_USER="hello.wisefind@gmail.com"
GMAIL_APP_PASSWORD=""

# -------------------------------------------------------------
# FLIPKART AFFILIATE & PRODUCT SEARCH API
# -------------------------------------------------------------
# Required for live Flipkart product search, price tracking, and affiliate links
FLIPKART_AFFILIATE_ID="wisefind01"
FLIPKART_AFFILIATE_TOKEN="your_flipkart_affiliate_token"
FLIPKART_API_KEY="your_flipkart_api_key"
